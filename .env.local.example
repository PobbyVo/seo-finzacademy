# Copy to .env.local and configure only when ready. Never commit API keys.
# AI disabled by default; SQLite and Semrush file analysis work without AI.
AI_PROVIDER=disabled
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Example (uncomment and adjust to a model already installed locally):
# AI_PROVIDER=ollama
# AI_BASE_URL=http://127.0.0.1:11434/v1/chat/completions
# AI_MODEL=<MODEL_INSTALLED_LOCALLY>
